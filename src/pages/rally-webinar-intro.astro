---

function shouldRedirectNow(now = new Date()) {
  const y = now.getUTCFullYear();
  const m = now.getUTCMonth(); // 0 = Jan → 9 = Oct
  const d = now.getUTCDate();
  const wd = now.getUTCDay(); // 4 = Thursday
  const h = now.getUTCHours();

  const isTargetDate = y === 2025 && m === 9 && d === 30 && wd === 4;
  const inWindow = h >= 13 && h < 16; // 13:00 ≤ t < 16:00 GMT
  return isTargetDate && inWindow;
}


if (shouldRedirectNow()) {
  return new Response(null, {
    status: 302,
    headers: { Location: targetUrl },
  });
}


return new Response(
  `<!doctype html>
